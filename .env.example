# Copy to .env and start with:  node --env-file=.env server.js
# Every setting is optional; the values shown are the defaults.

# Where to listen. Keep it on loopback unless you have TLS and a firewall in front.
LONG_TERM_HOST=127.0.0.1
LONG_TERM_PORT=8787

# State: the access token, test targets and runs, and the test lab.
LONG_TERM_DATA_DIR=~/.long-term

# The folder the Editor shows and new terminals start in.
# Point it at your projects directory, e.g. /home/you/projects
LONG_TERM_WORKSPACE=~/.long-term/workspace

# Access token. If unset, a random one is generated on first start and saved to
# $LONG_TERM_DATA_DIR/token (mode 0600) and printed in the server log. Minimum 12 characters.
# LONG_TERM_TOKEN=

# Behind a reverse proxy: trust X-Forwarded-Proto so the session cookie is marked Secure,
# and list the public host name(s) you serve from (comma-separated).
# LONG_TERM_TRUST_PROXY=1
# LONG_TERM_ALLOWED_HOSTS=long-term.example.com

# Concurrent browser terminals.
LONG_TERM_MAX_TERMINALS=12

# tmux server socket name (tmux -L). Keeps these sessions apart from your own tmux.
LONG_TERM_TMUX_SOCKET=long-term

# Tests: the command that starts the AI test engineer inside a tmux session, how long a
# run may take, and the time it gets to start before its prompt is pasted in.
LONG_TERM_TEST_COMMAND=claude
LONG_TERM_TEST_TIMEOUT_MIN=30
LONG_TERM_TEST_BOOT_MS=4000
